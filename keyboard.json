{
  "manufacturer": "johnybx",
  "keyboard_name": "Dactyl Manuform mini 4x6 5 thumb keys",
  "maintainer": "johnybx",
  "bootloader": "rp2040",
  "bootmagic": {
    "enabled": true
  },
  "diode_direction": "ROW2COL",
  "leader_key": {
    "timeout": 300
  },
  "mouse_key": {
    "enabled": false
  },
  "mousekey": {
    "delay": 0,
    "interval": 20,
    "max_speed": 7,
    "time_to_max": 60,
    "wheel_delay": 0
  },
  "processor": "RP2040",
  "rgblight": {
    "led_count": 50,
    "max_brightness": 150,
    "sleep": true,
    "split": true,
    "split_count": [25, 25],
    "driver": "ws2812",
    "layers": {
      "enabled": true,
      "max": 8
    }
  },
  "matrix_pins": {
    "rows": ["GP15", "GP14", "GP13", "GP12", "GP11"],
    "cols": ["GP26", "GP22", "GP21", "GP20", "GP19", "GP18"]
  },
  "split": {
    "enabled": true,
    "serial": {
      "driver": "vendor"
    }
  },
  "tapping": {
    "term": 200
  },
  "url": "https://github.com/johnybx/dactyl-manuform-mini-keymap",
  "usb": {
    "device_version": "0.1.0",
    "pid": "0x3436",
    "suspend_wakeup_delay": 0,
    "vid": "0x444D"
  },
  "ws2812": {
    "driver": "vendor",
    "pin": "GP0"
  },
  "layouts": {
